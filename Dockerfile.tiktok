FROM node:22-bookworm-slim
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci && npx playwright install --with-deps chromium \
    && apt-get update && apt-get install -y --no-install-recommends xvfb xauth \
    && rm -rf /var/lib/apt/lists/*
COPY lib ./lib
COPY worker ./worker
COPY tsconfig.json ./
COPY deploy/start-tiktok-browser.sh /app/deploy/start-tiktok-browser.sh
RUN sed -i 's/\r$//' /app/deploy/start-tiktok-browser.sh && chmod +x /app/deploy/start-tiktok-browser.sh
ENV NODE_ENV=production TIKTOK_BROWSER_HEADLESS=false TIKTOK_BROWSER_CHANNEL=chromium
# A real browser on a private virtual display; no window on the owner's desktop.
ENTRYPOINT ["/app/deploy/start-tiktok-browser.sh"]
CMD ["npm", "run", "worker:tiktok"]
