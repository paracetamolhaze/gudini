# === ИИ ===
# Ключ Anthropic (console.anthropic.com) — генерация сценариев и описаний.
# Без ключа работает демо-режим с шаблонными сценариями.
ANTHROPIC_API_KEY=

# Ключ ElevenLabs (elevenlabs.io) — Scribe: точные субтитры по речи (приоритетный вариант).
ELEVENLABS_API_KEY=

# Ключ OpenAI (platform.openai.com) — Whisper, запасной вариант субтитров.
# Без обоих ключей субтитры строятся по тексту сценария (равномерная раскладка).
OPENAI_API_KEY=

# Ключ Pexels (pexels.com/api, бесплатный) — стоковые видео для б-ролл перебивок.
PEXELS_API_KEY=

# Ключ Pixabay (pixabay.com/api/docs, бесплатный) — второй источник стока.
PIXABAY_API_KEY=

# Ключ Runway (dev.runwayml.com) — ИИ-генерация перебивок точно под фразу (~$0.30/клип).
# Если задан — приоритетнее стока; сток остаётся запасным вариантом.
RUNWAY_API_KEY=

# === Публикация ===
# YouTube Shorts: OAuth-приложение в Google Cloud Console (YouTube Data API v3).
# Redirect URI: http://localhost:3000/api/auth/youtube/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# TikTok: приложение на developers.tiktok.com (Content Posting API).
# Redirect URI: http://localhost:3000/api/auth/tiktok/callback
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Instagram Reels: приложение на developers.facebook.com (Instagram Graph API).
# Для Reels нужен публичный URL видео — укажите PUBLIC_BASE_URL при деплое.
META_APP_ID=
META_APP_SECRET=
# ID конфигурации «Входа через Facebook для бизнеса» (Facebook Login → Configurations)
META_CONFIG_ID=
PUBLIC_BASE_URL=

# Путь к ffmpeg, если его нет в PATH
FFMPEG_PATH=
FFPROBE_PATH=

# Пароль для входа на сайт, когда он доступен из интернета (Basic Auth).
# Пусто — без пароля. /terms, /privacy и отдача видео открыты всегда.
SITE_PASSWORD=

# === Локальный запуск в Docker (docker-compose.yml) ===
# Пароль входа на сайт; воркер использует его же для API сайта.
GUDINI_PASSWORD=
# Публичный адрес сайта через DuckDNS (профиль `public`): xxx.duckdns.org
DOMAIN=
DUCKDNS_SUBDOMAIN=
DUCKDNS_TOKEN=
# Тот же адрес с https:// — им подписываются OAuth-коллбэки и ссылки на видео
SITE_URL=

# Необязательно: ключ Anthropic со страницы Console → Settings → Admin keys (sk-ant-admin01-…) —
# дашборд покажет расход за сегодня и с начала месяца. Personal-ключ из «API keys», привязанный
# к workspace, не подходит. Остаток кредитов Anthropic по API не отдаёт ни одним ключом.
ANTHROPIC_ADMIN_KEY=

# Транспорт Claude для конвейера: anthropic (по умолчанию, ключ ANTHROPIC_API_KEY) или openrouter —
# те же модели через OpenRouter отдельным ключом. Тарифы на токены одинаковые; OpenRouter берёт
# 5,5 % при пополнении и не начисляет налог, называет точную цену вызова, остаток ключа виден на /balances.
MEDIA_LLM_TRANSPORT=anthropic
OPENROUTER_CLAUDE_KEY=

# Публикация (подробно: docs/PUBLISHING-SETUP.md)
# YouTube: private (черновик, по умолчанию) | unlisted | public — сразу в общий доступ
YOUTUBE_PRIVACY=private
# TikTok: 1 — прямая публикация с подписью и обложкой по таймкоду (нужен аудит Content Posting API);
# пусто — черновик в «Уведомления → Загрузки»
TIKTOK_DIRECT_POST=
TIKTOK_PRIVACY=PUBLIC_TO_EVERYONE
# содержимое файла проверки домена TikTok (tiktok*.txt), нужно только для загрузки по ссылке
TIKTOK_VERIFY_CONTENT=

# Подтверждение домена в Google Search Console (HTML tag → content="…"): без него Google не показывает
# логотип и имя приложения на экране входа, подключение YouTube при этом работает
GOOGLE_SITE_VERIFICATION=

# Обложка первым кадром для TikTok (превью — кадр 0): один кадр, 0.034 с по умолчанию, 0 — выключить
COVER_LEAD_SEC=0.034

# --- AI-фильм (второй стиль монтажа): Veo на Vertex AI ---
# GCLOUD_ADC_FILE=C:/Users/<you>/AppData/Roaming/gcloud/application_default_credentials.json
# MEDIA_FILM_MAX_COST_USD=12
# AI_FILM_MODEL=veo-3.1-fast-generate-001
# AI_FILM_PRICE_PER_SEC=0.15
# GCP_PROJECT=gudini-506711
# VEO_BUCKET=gudini-506711-veo

# --- AI-фильм v2 (Gudini Narrative Mode) ---
# AI_FILM_CHARACTER_ID=gudini
# AI_FILM_CHARACTER_DIR=assets/ai-film/characters
# AI_FILM_REQUIRE_REFERENCES=1          # 0 — разрешить сцены с героем без эталонных картинок
# AI_FILM_TARGET_COVERAGE=0.35          # ориентир доли ролика с AI
# AI_FILM_MAX_COVERAGE=0.55             # жёсткий предел доли
# AI_FILM_VEO_CONCURRENCY=3             # параллельных групп Veo
# AI_FILM_ESTIMATED_VEO_CALL_MINUTES=2  # минут на один вызов Veo (для оценки времени)
# AI_FILM_ENVIRONMENT_MODEL=veo-3.1-fast-generate-001  # модель для сцен без героя (в будущем Lite)
