# Браузер X: отдельный контейнер с Chromium на виртуальном экране. Он хранит вход владельца
# и выполняет публикации; платный API X здесь не участвует.
FROM node:22-bookworm-slim
WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund \
    && npx playwright install --with-deps chromium \
    && apt-get update \
    && apt-get install -y --no-install-recommends xvfb xauth fonts-dejavu-core fonts-liberation \
    && rm -rf /var/lib/apt/lists/*

COPY . .
RUN npm run build:server

ENV NODE_ENV=production \
    DATA_DIR=/app/data \
    X_BROWSER_HEADLESS=false \
    X_BROWSER_CHANNEL=chromium
VOLUME ["/app/data"]

# Настоящий браузер на приватном экране: на рабочем столе владельца окно не появляется.
ENTRYPOINT ["/app/deploy/start-x-browser.sh"]
CMD ["node", "dist/src/xbrowser.js"]
