{
  "name": "gudini-threads",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Autonomous Russian-language crypto Threads account: source watching, fact checking, writing, image translation, publishing, replies, analytics.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "npm run build:server && npm run build:web",
    "build:server": "tsc -p tsconfig.json",
    "build:web": "vite build --config web/vite.config.ts",
    "start": "node dist/src/index.js",
    "start:worker": "node dist/src/worker.js",
    "migrate": "tsx src/db/migrate.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "test": "tsx --test tests/unit/*.test.ts",
    "test:integration": "tsx --test tests/integration/*.test.ts",
    "backup": "node scripts/backup.mjs",
    "bridge": "node scripts/claude-bridge.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@fastify/static": "^8.2.0",
    "bullmq": "^5.56.0",
    "fastify": "^5.4.0",
    "ioredis": "^5.6.1",
    "opentype.js": "^2.0.0",
    "pg": "^8.16.0",
    "pino": "^9.7.0",
    "sharp": "^0.34.3",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/opentype.js": "^1.3.10",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "pino-pretty": "^13.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
