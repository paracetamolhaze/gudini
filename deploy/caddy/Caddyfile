{$DOMAIN} {
	encode zstd gzip
	# вкладка /clipy — контейнер clipy (замена лица на GPU); вход тот же, что у сайта
	handle /clipy* {
		reverse_proxy clipy:8500 {
			flush_interval -1
		}
	}
	# сайт внутри сети Docker; тела запросов не ограничены — исходники на гигабайт проходят
	handle {
		reverse_proxy gudini-site:3000 {
			flush_interval -1
		}
	}
	tls {
		dns duckdns {$DUCKDNS_TOKEN}
	}
}
