FROM node:22-bookworm-slim

# ffmpeg для монтажа, fonts-liberation — шрифт субтитров (аналог Arial)
RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg fontconfig fonts-liberation python3 python3-pip \
    && pip3 install --no-cache-dir --break-system-packages yt-dlp     && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY tsconfig.json ./
COPY lib ./lib
COPY worker ./worker
COPY fonts ./fonts

CMD ["npx", "tsx", "worker/index.ts"]
