# Gudini Threads — обособленный сервис (threads/). Файл читают контейнеры threads-app и threads-worker.
# Секреты живут только здесь: в БД, логах и ответах API их нет.

# --- Обязательное ---
# Внутри Docker эти адреса подставляет docker-compose.yml; при локальном запуске задайте свои.
# DATABASE_URL=postgres://threads:threads@localhost:5433/threads
# REDIS_URL=redis://localhost:6380

# --- Threads API (developers.facebook.com → приложение → Threads API → User Token Generator) ---
# Нужные разрешения на токене: threads_basic, threads_content_publish, threads_read_replies,
# threads_manage_replies, threads_manage_mentions, threads_keyword_search, threads_manage_insights,
# threads_profile_discovery (публичные посты чужих профилей). Без Advanced Access часть данных
# ограничена тестерами приложения — UI честно показывает "API permission required".
THREADS_ACCESS_TOKEN=
# Необязательно: числовой id профиля (иначе берётся из /me)
THREADS_USER_ID=
# Для обмена короткого токена на долгоживущий (60 дней) через API
THREADS_APP_ID=
THREADS_APP_SECRET=

# --- X: собственный браузер, ключи не нужны ---
# X работает так же, как TikTok: отдельный контейнер x-browser держит настоящий Chromium с вашим входом.
# Вы один раз входите в окне браузера прямо в дашборде (Настройки → Подключения → «Подключить X»),
# пароль идёт напрямую в X — сервис его не видит и не хранит. Платы за публикации и за чтение чужих
# постов нет. Ничего из этого раздела заполнять не обязательно: значения по умолчанию рабочие.
#
# Пароль между сервисом и контейнером. Нужен, только если контейнер слушает сеть (в docker-compose так и есть).
X_BROWSER_TOKEN=
# Адрес контейнера. Внутри Docker — http://x-browser:43132; при локальном запуске — http://127.0.0.1:43132.
# X_BROWSER_URL=http://x-browser:43132
#
# Запасной путь: старый платный API X. Включается только этой строкой и четырьмя ключами ниже.
# X_TRANSPORT=api
# X_API_KEY=
# X_API_SECRET=
# X_ACCESS_TOKEN=
# X_ACCESS_SECRET=

# --- Hyperliquid ---
# Только ПУБЛИЧНЫЙ адрес кошелька (0x…, 42 символа): по нему читаются исполнения сделок. Приватный ключ и сид-фраза
# не нужны и нигде не используются. Адрес можно указать и в Настройках → Сделки.
HYPERLIQUID_WALLET=
# Необязательно: demo-ключ CoinGecko поднимает лимиты запросов для поиска громких движений
COINGECKO_API_KEY=

# --- LLM ---
# Тексты для Threads и X пишет Claude по вашей подписке через локальный мост (раздел «Мост к Claude Code»
# ниже). Платный ключ для этого не нужен — оставьте claude-bridge.
# Другие варианты, если мост не используется: openrouter | openai | anthropic | gemini | openai-compatible
LLM_PROVIDER=claude-bridge
# Ключи ниже нужны только запасным провайдерам. При работающем мосте они остаются пустыми.
LLM_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Для openai-compatible (Ollama, LM Studio, свой шлюз): базовый URL вида http://host:11434/v1
LLM_BASE_URL=
# Модели по задачам в формате provider:model или просто model (провайдер по умолчанию).
# Одна модель может обслуживать все задачи. Примеры: openrouter:anthropic/claude-sonnet-5,
# anthropic:claude-sonnet-5, gemini:gemini-3.5-flash, openai:gpt-5-mini
LLM_MODEL_ANALYSIS=
LLM_MODEL_WRITER=
LLM_MODEL_REPLY=
LLM_MODEL_VISION=
LLM_MODEL_TRANSLATION=
# Эмбеддинги для семантической дедупликации (необязательно; без них работает shingle-сходство)
LLM_MODEL_EMBEDDING=

# --- Мост к Claude Code (тексты по подписке, без оплаты API) ---
# Это маленький локальный сервис на вашем Windows-компьютере: он запускает Claude Code CLI под вашей
# подпиской Max и отдаёт готовый текст сервису Threads. Счёт за API не выставляется.
#
# Как включить:
#   1. Войдите в CLI из npm (десктопная заглушка `claude` для этого не годится):
#      node C:/nvm4w/nodejs/node_modules/@anthropic-ai/claude-code/cli.js  → команда /login
#   2. Придумайте себе длинный пароль для моста (минимум 32 символа) и впишите его в CLAUDE_BRIDGE_TOKEN
#      здесь и в .env той папки, из которой запускаете мост.
#   3. В папке threads/ запустите `npm run bridge` и оставьте окно открытым, пока работает сервис.
#   4. Выберите провайдера: LLM_PROVIDER=claude-bridge (или отдельные задачи вида
#      LLM_MODEL_WRITER=claude-bridge:opus).
# Если CLI не залогинен или кончился лимит подписки, сервис покажет это прямым сообщением,
# а не промолчит.
#
# Адрес моста. Локальный запуск — http://127.0.0.1:43131. Из Docker — http://host.docker.internal:43131,
# и тогда мост нужно поднимать с CLAUDE_BRIDGE_HOST=0.0.0.0, иначе контейнер до него не достучится.
CLAUDE_BRIDGE_URL=
# Пароль моста: придумайте сами, минимум 32 символа. Никуда не отправляется, кроме вашего же компьютера.
CLAUDE_BRIDGE_TOKEN=
# Модель по умолчанию для всех задач
CLAUDE_BRIDGE_MODEL=sonnet
# Модель для постов — здесь можно взять посильнее
CLAUDE_BRIDGE_MODEL_WRITER=opus
# Свежие новости прямо из интернета: припишите +web к модели задачи, и этому запуску будут
# разрешены только поиск и чтение страниц. Пример: LLM_MODEL_ANALYSIS=claude-bridge:sonnet+web
#
# Если порт занят (например, вторым мостом Codex), мост скажет об этом при запуске — возьмите соседний.
#
# Необязательное (значения по умолчанию подходят): CLAUDE_BRIDGE_PORT=43131,
# CLAUDE_BRIDGE_HOST=127.0.0.1, CLAUDE_BRIDGE_TIMEOUT_MS=300000 (время на один ответ),
# CLAUDE_BRIDGE_QUEUE_MAX=4 (сколько заданий ждут очереди), CLAUDE_BRIDGE_CLI=путь к cli.js.

# --- Режимы и предохранители (все опасные функции по умолчанию выключены) ---
# OFF | DRAFT | REVIEW | AUTO — стартовый режим; дальше меняется в Settings
AUTOPILOT_MODE=DRAFT
# true — Threads только читается; publish/reply пишутся в лог вместо отправки
DRY_RUN=true
AUTO_POST_ENABLED=false
AUTO_OWN_REPLIES=false
AUTO_PUBLIC_REPLIES=false
IMAGE_TRANSLATION_ENABLED=false

# --- Прочее ---
LOG_LEVEL=info
TIMEZONE=Europe/Moscow
# Публичный адрес сайта (для ссылок на картинки, которые Threads скачивает сам)
# PUBLIC_BASE_URL=https://gudinijr.duckdns.org
